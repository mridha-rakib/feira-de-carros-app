{
  "name": "app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.20",
    "@tanstack/react-query": "^5.104.4",
    "expo": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.4",
    "expo-image": "~58.0.15",
    "expo-linking": "~58.0.13",
    "expo-network": "~58.0.3",
    "expo-router": "~58.0.23",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.11",
    "lint-staged": "^17.6.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "doctor": "npx expo-doctor@latest",
    "validate": "npm run typecheck && npm run check && npm run test:ci",
    "prepare": "husky",
    "reset-project": "node ./scripts/reset-project.js",
    "check:fix": "biome check --write .",
    "deps:check": "expo install --check",
    "hooks:verify": "node scripts/verify-hooks.mjs",
    "export:web": "expo export --platform web",
    "start:dev": "expo start --dev-client",
    "android:build": "expo run:android",
    "android:go": "expo start --go --android",
    "security:audit": "npm audit",
    "security:production": "npm audit --omit=dev",
    "security:report": "node scripts/security-report.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  }
}
